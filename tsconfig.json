{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["apps/web/*"], "@signal/*": ["packages/*/index.ts"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "apps/web/.next/types/**/*.ts"],
  "exclude": ["node_modules", "apps/web/.next/dev", "work"]
}
