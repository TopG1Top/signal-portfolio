{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "ingest": "tsx apps/worker/once.ts",
    "worker": "tsx apps/worker/index.ts",
    "admin": "tsx scripts/admin.ts",
    "prisma:validate": "prisma validate --schema packages/database/schema.prisma",
    "postinstall": "node scripts/assets.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "ai:index": "tsx scripts/embeddings.ts",
    "dev:portfolio": "node scripts/portfolio.mjs dev",
    "build:portfolio": "node scripts/portfolio.mjs build",
    "start:portfolio": "node scripts/portfolio.mjs start",
    "test:portfolio": "playwright test --config playwright.portfolio.config.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/mapbox": "^9.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "1.7.10",
    "bullmq": "^5.65.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.0",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "fast-xml-parser": "^5.3.6",
    "ioredis": "^5.8.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^12.34.0",
    "next": "16.4.2",
    "next-intl": "^4.8.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.0",
    "zod": "^4.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.9.0-beta.16",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
