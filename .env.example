DATABASE_URL=postgresql://signal:change-me@127.0.0.1:5432/signal
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
INGEST_INTERVAL_MS=300000
# Live is the default. Synthetic events are isolated with ?mode=demo.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
POSTGRES_PASSWORD=replace-with-random-docker-database-password
RSS_ENABLED=false
NEWS_FEEDS_ENABLED=true
# SRF/tagesschau/heise headlines for local personal reading; review publisher rights before public deployment.
# Only pre-approved NASA RSS metadata is supported by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REQUIRE_EMAIL_VERIFICATION=false
